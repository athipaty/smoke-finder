{
  "name": "smoke-finder",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Singapore smoking spot finder: data pipeline and the F1 \"Can I smoke here?\" engine",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "fetch": "node scripts/fetch-data.js",
    "build:data": "node scripts/build-zones.js",
    "data": "npm run fetch && npm run build:data",
    "import": "node --env-file-if-exists=.env scripts/import-mongo.js",
    "check": "node src/cli.js",
    "spotcheck": "node scripts/spotcheck.js",
    "test": "node --test",
    "fetch:nsz": "node --env-file-if-exists=.env scripts/fetch-nsz.js"
  },
  "devDependencies": {
    "mongodb": "^6.10.0"
  }
}
